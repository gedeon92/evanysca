# --- Base de données (obligatoire) -------------------------------------------------------------
# DATABASE_URL : la chaîne « Pooled connection » de Neon (son hôte contient `-pooler`). C'est elle
# que l'API utilise au quotidien.
DATABASE_URL=postgresql://user:motdepasse@ep-xxx-pooler.eu-central-1.aws.neon.tech/boutique_whatsapp?sslmode=require

# DIRECT_URL : la même chaîne SANS `-pooler`. Elle ne sert qu'à `prisma migrate`, qui a besoin de
# verrous de session que PgBouncer ne sait pas relayer. À laisser vide sur un PostgreSQL local.
DIRECT_URL=postgresql://user:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/boutique_whatsapp?sslmode=require

PORT=4000
NODE_ENV=development

# --- CORS (obligatoire) ------------------------------------------------------------------------
# Liste séparée par des virgules, SANS slash final. Le domaine nu et le www sont deux origines
# distinctes : les deux doivent figurer ici, comme chaque nouvelle adresse de déploiement.
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# --- JWT (obligatoire, 16 caractères minimum) --------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CLIENT_APP_URL=http://localhost:8080
ADMIN_APP_URL=http://localhost:8081

# --- Cloudinary (optionnel) --------------------------------------------------------------------
# Sans ces variables, l'API démarre normalement : seul l'envoi d'images échoue, avec un message clair.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL de l'API, sans slash final. En production : l'adresse du service Render.
VITE_API_URL=http://localhost:4000/api

# Numéro WhatsApp de la vendeuse, au format international SANS « + » ni espaces.
# C'est vers lui que part chaque commande. Exemple Sénégal : 221770000000
VITE_WHATSAPP_NUMBER=221770000000

# --- Identité de la marque ---------------------------------------------------------------------
# Tout ce qui suit est affiché sur le site. Rien n'est écrit en dur dans le code : le jour où la
# cliente communique ses informations définitives, tout se change ici.
VITE_BRAND_NAME=Maison Séraphine
VITE_BRAND_TAGLINE=Pièces façonnées à la main, en série très limitée
VITE_BRAND_CITY=Dakar
VITE_BRAND_EMAIL=
VITE_BRAND_INSTAGRAM=
